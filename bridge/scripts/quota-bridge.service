[Unit]
Description=AI Quota Bridge (OpenCode -> CYD/TV-154 dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Project/bridge
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
Environment=PORT=3847
Environment=HOST=0.0.0.0
Environment=MDNS_NAME=quota-bridge
Environment=POLL_OC_SEC=45
Environment=ENDWORK_WATCH_SEC=5
Environment=OPENCODE_DB=%h/.local/share/opencode/opencode.db

[Install]
WantedBy=default.target
