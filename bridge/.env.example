# Copy to .env to override defaults
PORT=3847
HOST=0.0.0.0
MDNS_NAME=quota-bridge
# OpenCode collector cache TTL (also its Console background poll interval).
# HTTP handlers serve cache in ~0ms; collector refreshes in background.
# Keep >= 10; 45s default balances Console rate limits vs freshness.
POLL_OC_SEC=45
# Path to the OpenCode SQLite DB (default: ~/.local/share/opencode/opencode.db)
# OPENCODE_DB=/home/enrik/.local/share/opencode/opencode.db
# Optional: `opencode-quota` binary for the export-cache fallback ("npx" uses the pinned package)
# OPENCODE_QUOTA_BIN=npx
# Optional USB Serial push (zero-Wi-Fi desk setup)
# SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200
SERIAL_INTERVAL_SEC=10
# Optional bearer token for mutating routes (AUDIT P3-17).
# When set, POST /api/ask and POST /api/ask/answer require
# `Authorization: Bearer <token>`. GETs stay open (CYD poll needs no secret).
# Firmware: baked via -D or CYD_TOKEN env at build/flash time (see README).
# CYD_TOKEN=
# Optional: `ENDWORK_WATCH=0` disables the auto END OF WORK watcher entirely.
# Cadence of the session-idle poll (seconds, min 2):
# ENDWORK_WATCH_SEC=5
# Where the undismissed END OF WORK latch persists across bridge restarts:
# ENDWORK_STATE_FILE=/home/enrik/.local/share/ai-quota-bridge/endwork.json
# Agent helper defaults (ask-cyd.sh):
# CYD_BRIDGE_URL=http://192.168.1.59:3847
# ASK_TIMEOUT_SEC=30
