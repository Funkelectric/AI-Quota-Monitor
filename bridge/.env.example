# Copy to .env to override defaults
PORT=3847
HOST=0.0.0.0
MDNS_NAME=quota-bridge
POLL_AG_SEC=15
# (unused, kept for compatibility)
# OpenCode collector cache TTL (also its Console poll interval)
POLL_OC_SEC=45
# Path to the OpenCode SQLite DB (default: ~/.local/share/opencode/opencode.db)
# OPENCODE_DB=/home/enrik/.local/share/opencode/opencode.db
# Optional: `opencode-quota` binary for the export-cache fallback ("npx" uses the pinned package)
# OPENCODE_QUOTA_BIN=npx
# Optional USB Serial push (zero-Wi-Fi desk setup)
# SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200
SERIAL_INTERVAL_SEC=10
